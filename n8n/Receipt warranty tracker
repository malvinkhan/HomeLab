    {
      "id": "p2",
      "name": "Poll Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        0
      ],
      "parameters": {
        "jsCode": "const BOT_TOKEN = 'PASTE_YOUR_BOT_TOKEN_HERE';\n\nconst data = $getWorkflowStaticData('global');\nconst qs = { timeout: 0, allowed_updates: JSON.stringify(['message']) };\nif (data.offset) qs.offset = data.offset;\n\nconst res = await this.helpers.httpRequest({\n  method: 'GET',\n  url: 'https://api.telegram.org/bot' + BOT_TOKEN + '/getUpdates',\n  qs,\n  json: true\n});\n\nconst updates = res.result || [];\nif (!updates.length) return [];\n\nconst isReceipt = m => m && (m.photo || (m.document && (m.document.mime_type || '').startsWith('image/')));\n\n// Take the first update that is a photo, skipping text messages\nconst hit = updates.find(u => isReceipt(u.message));\nif (hit) {\n  data.offset = hit.update_id + 1;\n  return [{ json: { message: hit.message } }];\n}\n\n// No photos: move past the text messages so they don't block later ones\ndata.offset = updates[updates.length - 1].update_id + 1;\nreturn [];"
      }
