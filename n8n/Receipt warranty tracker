          "mode": "id"
        },
        "returnAll": true,
        "simple": false,
        "filterType": "json",
        "filterJson": "={{ JSON.stringify({and:[{property:'Coverage End',date:{on_or_after:$today.toISODate()}},{property:'Coverage End',date:{on_or_before:$today.plus({days:30}).toISODate()}}]}) }}",
        "options": {}
