{
  "name": "Receipt to Warranty Tracker",
  "nodes": [
    {
      "id": "n2",
      "name": "Get Photo File ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const m = $input.first().json.message;\nlet fileId = null;\nif (m.photo && m.photo.length) {\n  fileId = m.photo[m.photo.length - 1].file_id;\n} else if (m.document && (m.document.mime_type || '').startsWith('image/')) {\n  fileId = m.document.file_id;\n}\nif (!fileId) return [];\nreturn [{ json: { file_id: fileId, chat_id: m.chat.id, caption: m.caption || '' } }];"
      }
    },
    {
      "id": "n3",
      "name": "Download File",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{ $json.file_id }}",
        "download": true
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "n4",
      "name": "Build Ollama Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Change this to any vision-capable model you have pulled in Ollama\nconst MODEL = 'qwen2.5vl:7b';\n\nconst bin = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst caption = $('Get Photo File ID').first().json.caption;\n\nconst prompt = 'Extract details from this receipt or invoice. Return ONLY a JSON object with no other text, using these keys: ' +\n  'item (the main product purchased; if there are several, the highest-priced one), ' +\n  'store (retailer name), ' +\n  'price (number, the price of that item in dollars, no currency symbol), ' +\n  'purchase_date (YYYY-MM-DD), ' +\n  'warranty_months (number of months ONLY if a warranty period is explicitly printed on the document, otherwise null), ' +\n  'return_days (number of days of the return or exchange window ONLY if it is explicitly printed on the document, otherwise null; do not guess), ' +\n  'notes (model, serial number or other useful details, otherwise an empty string). ' +\n  (caption ? 'The user added this caption, use it if it helps: ' + caption : '');\n\nconst body = {\n  model: MODEL,\n  stream: false,\n  format: 'json',\n  options: { temperature: 0 },\n  messages: [{ role: 'user', content: prompt, images: [bin.toString('base64')] }]\n};\nreturn [{ json: { body } }];"
      }
    },
    {
      "id": "n5",
      "name": "Ollama Reads Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 180000
        }
      }
    },
    {
      "id": "n6",
      "name": "Parse and Calculate Warranty",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const DB_ID = 'YOUR_NOTION_DATABASE_ID';\n\nconst chat_id = $('Get Photo File ID').first().json.chat_id;\nconst raw = $input.first().json.message.content;\nconst clean = raw.replace(/```json|```/g, '').trim();\n\nlet d = null;\ntry { d = JSON.parse(clean); } catch (e) {}\nif (!d) return [{ json: { ok: false, chat_id } }];\n\nconst num = v => (v === null || v === undefined || v === '') ? NaN : Number(v);\nconst cut = s => String(s || '').slice(0, 1900);\n\nconst item = d.item || 'Unknown item';\nconst store = d.store || '';\nconst price = num(d.price);\nconst purchase = /^\\d{4}-\\d{2}-\\d{2}$/.test(d.purchase_date || '') ? d.purchase_date : new Date().toISOString().slice(0, 10);\nconst wMonths = num(d.warranty_months);\nconst rDays = num(d.return_days);\n\nlet type = 'None', months = null, end = null;\nlet summary = 'Logged: ' + item + (store ? ' (' + store + ')' : '') + '\\nNo warranty or return window found on the receipt.';\n\nif (wMonths > 0) {\n  type = 'Warranty'; months = wMonths;\n  const e = new Date(purchase + 'T00:00:00Z'); e.setUTCMonth(e.getUTCMonth() + wMonths);\n  end = e.toISOString().slice(0, 10);\n  summary = 'Logged: ' + item + (store ? ' (' + store + ')' : '') + '\\nWarranty until ' + end + ' (' + wMonths + ' months, from the receipt)';\n} else if (rDays > 0) {\n  type = 'Return window';\n  const e = new Date(purchase + 'T00:00:00Z'); e.setUTCDate(e.getUTCDate() + rDays);\n  end = e.toISOString().slice(0, 10);\n  summary = 'Logged: ' + item + (store ? ' (' + store + ')' : '') + '\\nNo warranty on the receipt. Return window until ' + end + ' (' + rDays + ' days)';\n}\n\nconst props = {\n  'Item': { title: [{ text: { content: cut(item) } }] },\n  'Retailer': { rich_text: [{ text: { content: cut(store) } }] },\n  'Purchase Date': { date: { start: purchase } },\n  'Product Model/Serial': { rich_text: [{ text: { content: cut(d.notes) } }] },\n  'Coverage Type': { select: { name: type } }\n};\nif (Number.isFinite(price)) props['Amount'] = { number: price };\nif (months !== null) props['Warranty Length (months)'] = { number: months };\nif (end) props['Coverage End'] = { date: { start: end } };\nif (type !== 'None') props['Status'] = { select: { name: 'Active' } };\n\nreturn [{ json: { ok: true, chat_id, summary, notion_body: { parent: { database_id: DB_ID }, properties: props } } }];"
      }
    },
