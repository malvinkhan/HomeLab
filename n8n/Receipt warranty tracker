    {
      "id": "n13",
      "name": "Build Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        400
      ],
      "parameters": {
        "jsCode": "const lines = $input.all().map(i => {\n  const p = i.json.properties || {};\n  const title = (p['Item'] && p['Item'].title && p['Item'].title[0]) ? p['Item'].title[0].plain_text : 'Unknown item';\n  const end = (p['Coverage End'] && p['Coverage End'].date) ? p['Coverage End'].date.start : '?';\n  const type = (p['Coverage Type'] && p['Coverage Type'].select) ? p['Coverage Type'].select.name.toLowerCase() : 'coverage';\n  return '- ' + title + ': ' + type + ' ends ' + end;\n});\nreturn [{ json: { message: 'Ending in the next 30 days:\\n' + lines.join('\\n') } }];"
      }
    },
